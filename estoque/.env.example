# Copie este arquivo para .env e ajuste os valores.
# Nunca commite o arquivo .env real (ele está no .gitignore).

# Chave secreta usada para assinar/verificar tokens JWT (obrigatória, sem valor padrão).
# A aplicação NÃO inicia sem ela. Gere uma chave forte com:
#   openssl rand -base64 48
# O valor deve ser uma string Base64.
JWT_SECRET=

# Validade do token JWT em segundos (opcional, padrão: 300 = 5 minutos)
# JWT_VALIDITY=300

# URL base do frontend, usada para montar o link do convite de primeiro acesso
# (opcional, padrão: http://localhost:5173)
# APP_FRONTEND_URL=http://localhost:5173

# Validade do convite de usuário em horas (opcional, padrão: 24)
# APP_CONVITE_EXPIRACAO_HORAS=24
